# midnight-bridge configuration
# Copy to .env and fill in values

# Service port (default 3001, confirmed no collision with existing stack)
PORT=3001

# Simulation mode — set to "true" for local dev without a proof server.
# Set to "false" only after the contract is deployed and SDK packages are installed.
MIDNIGHT_SIMULATE=true

# Midnight network: "local-devnet" | "preview" | "preprod"
MIDNIGHT_NETWORK=local-devnet

# Proof server URL (local devnet)
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Deployed contract address (populated after successful deployment)
MIDNIGHT_CONTRACT_ADDRESS=

# Wallet seed for the deployment/attestation wallet (local devnet pre-funded)
# NEVER commit a real wallet seed — this placeholder is for local devnet only.
MIDNIGHT_WALLET_SEED=

# Indexer URL for querying ledger state
MIDNIGHT_INDEXER_URL=http://localhost:8088
