{
  "name": "midnight-bridge",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Minimal internal HTTP service wrapping Midnight SDK calls for the DeceptionShield Python backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test \"test/**/*.js\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/testkit-js": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.1",
    "testcontainers": "^12.1.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/wallet-sdk": "$@midnight-ntwrk/wallet-sdk",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "chai": "^6.2.2",
    "supertest": "^7.2.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
