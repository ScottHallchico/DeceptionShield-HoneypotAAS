# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://honeypot:honeypot_secret@localhost:5432/honeypot_db
DATABASE_SYNC_URL=postgresql://honeypot:honeypot_secret@localhost:5432/honeypot_db

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=raw-honeypot-events
KAFKA_NORMALIZED_TOPIC=normalized-events
KAFKA_CONSUMER_GROUP=honeypot-normalizer

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── GeoIP (MaxMind) ───────────────────────────────────────
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb
MAXMIND_ASN_DB_PATH=./data/GeoLite2-ASN.mmdb
MAXMIND_LICENSE_KEY=YOUR_MAXMIND_LICENSE_KEY

# ─── AbuseIPDB ──────────────────────────────────────────────
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_API_KEY

# ─── AWS (for Security Group auto-response) ─────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# ─── pfSense (for firewall auto-response) ───────────────────
PFSENSE_API_URL=https://192.168.1.1/api/v1
PFSENSE_API_KEY=
PFSENSE_API_SECRET=

# ─── AI Threat Assistant ────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── Alerting ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=

# ─── Application ────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
